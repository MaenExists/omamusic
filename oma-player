#!/usr/bin/env bash
# oma-player: backend bridge for OmaMusic plugin talking to headless cliamp daemon
set -eo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omamusic"
mkdir -p "$STATE_DIR"
STATUS_JSON="$STATE_DIR/status.json"
QUEUE_JSON="$STATE_DIR/queue.json"
FAVORITES_JSON="$STATE_DIR/favorites.json"

[ -f "$FAVORITES_JSON" ] || echo '[]' > "$FAVORITES_JSON"

play_sound() {
  local snd="$1"
  case "$snd" in
    click)
      canberra-gtk-play -i audio-volume-change 2>/dev/null || true
      ;;
    play)
      canberra-gtk-play -i dialog-information 2>/dev/null || true
      ;;
    favorite)
      canberra-gtk-play -i message-new-instant 2>/dev/null || true
      ;;
    trash)
      canberra-gtk-play -i trash-empty 2>/dev/null || true
      ;;
    restart)
      canberra-gtk-play -i complete 2>/dev/null || true
      ;;
  esac
}

ensure_daemon() {
  if ! cliamp status >/dev/null 2>&1; then
    # Start headless daemon with empty startup
    cliamp -d --low-power >/dev/null 2>&1 &
    for _ in {1..25}; do
      if cliamp status >/dev/null 2>&1; then
        # Ensure default tracks are wiped clean on launch
        cliamp remote call --wait queue.clear >/dev/null 2>&1 || true
        break
      fi
      sleep 0.1
    done
  fi
}

cmd="${1:-status}"

case "$cmd" in
  ensure)
    ensure_daemon
    echo '{"ok":true}'
    ;;

  restart-session)
    # Terminate running cliamp daemon and clear session
    pkill -f "cliamp -d" 2>/dev/null || true
    pkill -f "cliamp --daemon" 2>/dev/null || true
    sleep 0.4
    ensure_daemon
    play_sound restart &
    "$0" status
    ;;

  status)
    ensure_daemon
    cli_status=$(cliamp status --json 2>/dev/null || echo '{}')
    echo "$cli_status" > "$STATUS_JSON.tmp" && mv "$STATUS_JSON.tmp" "$STATUS_JSON"
    cat "$STATUS_JSON"
    ;;

  play)
    ensure_daemon
    cliamp play >/dev/null 2>&1 || true
    play_sound play &
    "$0" status
    ;;

  pause)
    ensure_daemon
    cliamp pause >/dev/null 2>&1 || true
    play_sound click &
    "$0" status
    ;;

  toggle)
    ensure_daemon
    cliamp toggle >/dev/null 2>&1 || true
    play_sound click &
    "$0" status
    ;;

  next)
    ensure_daemon
    cliamp next >/dev/null 2>&1 || true
    play_sound click &
    "$0" status
    ;;

  prev)
    ensure_daemon
    cliamp prev >/dev/null 2>&1 || true
    play_sound click &
    "$0" status
    ;;

  stop)
    ensure_daemon
    cliamp stop >/dev/null 2>&1 || true
    play_sound click &
    "$0" status
    ;;

  volume)
    ensure_daemon
    val="${2:-0}"
    if [ "$val" -gt 0 ] 2>/dev/null; then
      if [ "$val" -le 100 ]; then
        val_db=$(( (val - 100) * 30 / 100 ))
        cliamp volume "$val_db" >/dev/null 2>&1 || true
      else
        cliamp volume 0 >/dev/null 2>&1 || true
      fi
    else
      cliamp volume -30 >/dev/null 2>&1 || true
    fi
    "$0" status
    ;;

  play-url)
    ensure_daemon
    url="$2"
    if [ -n "$url" ]; then
      cliamp remote call --wait url.load --params "{\"path\":$(printf '%s' "$url" | jq -R .),\"play\":true}" >/dev/null 2>&1 || true
      play_sound play &
    fi
    "$0" status
    ;;

  queue-url)
    ensure_daemon
    url="$2"
    if [ -n "$url" ]; then
      cliamp remote call --wait url.load --params "{\"path\":$(printf '%s' "$url" | jq -R .),\"play\":false}" >/dev/null 2>&1 || true
      play_sound click &
    fi
    "$0" status
    ;;

  queue-list)
    ensure_daemon
    q_data=$(cliamp remote call --wait queue.list 2>/dev/null || echo '{}')
    tracks=$(echo "$q_data" | jq -c '.result.tracks // []' 2>/dev/null || echo '[]')
    idx=$(echo "$q_data" | jq -r '.result.index // -1' 2>/dev/null || echo '-1')
    jq -n -c --argjson tracks "$tracks" --arg index "$idx" '{ok: true, tracks: $tracks, currentIndex: ($index|tonumber)}'
    ;;

  queue-clear)
    ensure_daemon
    cliamp remote call --wait queue.clear >/dev/null 2>&1 || true
    play_sound trash &
    echo '{"ok":true}'
    ;;

  favorites-list)
    cat "$FAVORITES_JSON" 2>/dev/null || echo '[]'
    ;;

  favorites-toggle)
    track_json="$2"
    if [ -n "$track_json" ]; then
      id=$(echo "$track_json" | jq -r '.id // .url // ""')
      if [ -n "$id" ]; then
        exists=$(jq -r --arg id "$id" '.[] | select((.id // .url) == $id) | .id' "$FAVORITES_JSON" 2>/dev/null || true)
        if [ -n "$exists" ]; then
          # Remove from favorites
          jq -c --arg id "$id" 'map(select((.id // .url) != $id))' "$FAVORITES_JSON" > "$FAVORITES_JSON.tmp" \
            && mv "$FAVORITES_JSON.tmp" "$FAVORITES_JSON"
          play_sound click &
        else
          # Add to favorites
          jq -c --argjson track "$track_json" '. + [$track]' "$FAVORITES_JSON" > "$FAVORITES_JSON.tmp" \
            && mv "$FAVORITES_JSON.tmp" "$FAVORITES_JSON"
          play_sound favorite &
        fi
      fi
    fi
    cat "$FAVORITES_JSON"
    ;;

  sound)
    play_sound "$2"
    echo '{"ok":true}'
    ;;

  search)
    query="$2"
    limit="${3:-8}"
    if [ -z "$query" ]; then
      echo '{"ok":true,"results":[]}'
      exit 0
    fi

    results=$(yt-dlp --default-search "ytsearch$limit" \
      --dump-json \
      --no-playlist \
      --no-warnings \
      "ytsearch$limit:$query" 2>/dev/null \
      | jq -s -c 'map({
          id: .id,
          title: (.title // "Unknown"),
          artist: (.uploader // .channel // "Unknown"),
          duration: (.duration_string // ""),
          duration_secs: (.duration // 0),
          url: (.webpage_url // ("https://www.youtube.com/watch?v=" + .id))
        })') || results="[]"

    if [ -z "$results" ] || [ "$results" = "null" ]; then
      results="[]"
    fi

    jq -n -c --argjson items "$results" '{ok: true, results: $items}'
    ;;

  *)
    echo "Usage: $0 {ensure|restart-session|status|play|pause|toggle|next|prev|stop|volume <0-100>|play-url <url>|queue-url <url>|queue-list|queue-clear|favorites-list|favorites-toggle <json>|sound <name>|search <query> [limit]}"
    exit 1
    ;;
esac
